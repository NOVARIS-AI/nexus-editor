{
  "name": "nexus-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "verify:release": "node scripts/verify-release-assets.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:build": "npm run build && npm run android:prepare && npm run android:sync && node scripts/generate-android-branding.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@huggingface/transformers": "^4.3.2",
    "vosk-browser": "^0.0.8",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capawesome/capacitor-file-picker": "^7.0.0",
    "@nexus/native-engine": "file:./native-engine-plugin"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "@capacitor/cli": "^7.0.0"
  }
}
