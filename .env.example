# AI Brain (OpenAI-compatible chat completions endpoint)
NEXUS_AI_API_KEY=
NEXUS_AI_BASE_URL=
NEXUS_AI_MODEL=

# Cloudflare Workers AI bridge (server-only; never use VITE_ prefixes)
NEXUS_WORKER_URL=
NEXUS_WORKER_TOKEN=
NEXUS_APP_ORIGIN=

# NEXUS-managed model workers (server-to-server URLs and tokens)
NEXUS_IMAGE_ENGINE_URL=
NEXUS_IMAGE_ENGINE_TOKEN=
NEXUS_VIDEO_ENGINE_URL=
NEXUS_VIDEO_ENGINE_TOKEN=
NEXUS_AUDIO_ENGINE_URL=
NEXUS_AUDIO_ENGINE_TOKEN=
NEXUS_RENDER_ENGINE_URL=
NEXUS_RENDER_ENGINE_TOKEN=

# Online transcription provider (server-side secret; never use a VITE_ prefix)
GROQ_API_KEY=

# Optional Vosk browser model archive URL (public URL, not a secret/API key)
VITE_VOSK_MODEL_URL=
